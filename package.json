{
  "name": "elite-biotech-peptides",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dashboard:dev": "npm run dev --workspace @elite-biotech/dashboard",
    "dashboard:build": "npm run build --workspace @elite-biotech/dashboard",
    "api:dev": "npm run dev --workspace @elite-biotech/api",
    "worker:dev": "npm run dev --workspace @elite-biotech/worker",
    "worker:start": "npm run start --workspace @elite-biotech/worker",
    "seed": "node --import tsx scripts/seed-growth-os.ts",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate && node scripts/link-prisma-client.js",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "mobile": "npm run start --workspace mobile-app",
    "ios": "npm run ios --workspace mobile-app",
    "android": "npm run android --workspace mobile-app",
    "mobile:web": "npm run web --workspace mobile-app",
    "mobile:testflight": "npm run eas:testflight --workspace mobile-app",
    "mobile:ios:build": "npm run eas:build:ios --workspace mobile-app",
    "mobile:ios:submit": "npm run eas:submit:ios --workspace mobile-app",
    "mobile:android:build": "npm run eas:build:android --workspace mobile-app",
    "mobile:android:internal": "npm run eas:android:internal --workspace mobile-app",
    "mobile:android:submit:internal": "npm run eas:submit:android:internal --workspace mobile-app"
  },
  "dependencies": {
    "@elite-biotech/shared": "*",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.5.0",
    "@supabase/supabase-js": "^2.101.1",
    "next": "16.1.6",
    "pg": "^8.20.0",
    "prisma": "^7.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "ts-node": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
